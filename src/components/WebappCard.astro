---
interface Props {
  title: string;
  description: string;
  url: string;
}

const { title, description, url } = Astro.props as Props;
---

<div class="flex flex-col gap-3 p-4 rounded-xl border border-gray-200 dark:border-n700 dark:hover:bg-n800 transition-all">
  <!-- Title -->
  <h6 class="font-semibold text-xl text-n500 dark:text-white">
    <a href={url} class="hover:underline">
      {title}
    </a>
  </h6>

  <!-- Description -->
  <p class="text-sm text-n500 dark:text-n300">
    {description}
  </p>
</div>
